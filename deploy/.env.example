# Copy to deploy/.env and fill in. Never commit the copy.
# This file is passed to the melinda container; non-MELINDA_ entries are ignored by the agent. Variables that settings
# reference with env: values belong here too.

# Compose (not passed to melinda)
POSTGRES_PASSWORD=
SEARXNG_SECRET=
# IMAGE=melinda:latest
# SETTINGS_PATH=./settings.json
# PROMPTS_PATH=./prompts
# NETWORK=
# The agent's limit holds 256 MiB for analysing attachments and 400 MiB for reading a web page, however many replies
# run at once, plus normal operation and garbage collection headroom. Its Go runtime keeps to 90% of the limit.
AGENT_MEMORY_LIMIT=1g
POSTGRES_MEMORY_LIMIT=512m
SEARXNG_MEMORY_LIMIT=512m
VALKEY_MEMORY_LIMIT=256m

# Agent (optional; defaults shown). The bundled database is configured by compose.
# To use another database, set MELINDA_DATABASE_URL (percent-encode special characters in the password)
# and start with: docker compose up --no-deps melinda
# MELINDA_DATABASE_URL=
# MELINDA_AGENT_ID=melinda
# MELINDA_COMPONENTS=
# MELINDA_DRY_RUN=false
# MELINDA_HTTP_ADDR=:8080
# MELINDA_LOG_FORMAT=text
# MELINDA_LOG_LEVEL=INFO
# MELINDA_PIPELINE_RUN_TIMEOUT=30m
# MELINDA_PIPELINE_WORKERS=8
# MELINDA_SEARXNG_URL=http://searxng:8080
# MELINDA_SETTINGS_TTL=5s
# MELINDA_SHUTDOWN_TIMEOUT=30s
# MELINDA_TIMEZONE=UTC
# Go runtime soft memory limit; unset, 90% of the container's memory limit.
# GOMEMLIMIT=
