# Copy to deploy/.env and fill in. Never commit the copy.
# This file is passed to the dost container; non-DOST_ entries are ignored by the agent. Variables that settings
# reference with env: values belong here too.

# Compose (not passed to dost)
POSTGRES_PASSWORD=
SEARXNG_SECRET=
# IMAGE=dost:latest
# SETTINGS_PATH=./settings.json
# PROMPTS_PATH=./prompts
# NETWORK=
AGENT_MEMORY_LIMIT=512m
POSTGRES_MEMORY_LIMIT=512m
SEARXNG_MEMORY_LIMIT=512m
VALKEY_MEMORY_LIMIT=256m

# Agent (optional; defaults shown). The bundled database is configured by compose.
# To use another database, set DOST_DATABASE_URL (percent-encode special characters in the password)
# and start with: docker compose up --no-deps dost
# DOST_DATABASE_URL=
# DOST_AGENT_ID=dost
# DOST_COMPONENTS=
# DOST_DRY_RUN=false
# DOST_HTTP_ADDR=:8080
# DOST_LOG_FORMAT=text
# DOST_LOG_LEVEL=INFO
# DOST_PIPELINE_RUN_TIMEOUT=30m
# DOST_PIPELINE_WORKERS=8
# DOST_SEARXNG_URL=http://searxng:8080
# DOST_SETTINGS_TTL=5s
# DOST_SHUTDOWN_TIMEOUT=30s
# DOST_TIMEZONE=UTC
